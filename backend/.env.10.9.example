NODE_ENV=development
PORT=3001

# El script `npm run db:prepare` crea este archivo local si aún no existe.
# Nunca copiar credenciales de otras bases a esta configuración.
DB_HOST=127.0.0.1
DB_PORT=55442
DB_USERNAME=genares_dev_app
DB_PASSWORD=REEMPLAZAR_LOCALMENTE
DB_NAME=genares_dev_10_9
DB_SSL=false
DB_DISPOSABLE=false

# Identidad local fija de solo lectura, limitada por el servidor a 10.9B.
# Este perfil no activa escrituras ni acepta permisos enviados por el cliente.
LOCAL_DEV_OPEN_ACCESS=true
LOCAL_DEV_WRITE_ORIGINS=http://127.0.0.1:5173
