NODE_ENV=development
PORT=3001

# Identidad simulada fija del servidor, desactivada por defecto.
# Perfiles de lectura: lector, sin-capacidades, sin-identidad.
# administrador-rubricas requiere el script de PostgreSQL 9D y su opt-in explícito.
LOCAL_DEV_IDENTITY_ENABLED=false
LOCAL_DEV_IDENTITY_PROFILE=lector
LOCAL_DEV_WRITE_ENABLED=false
LOCAL_DEV_WRITE_ORIGINS=http://127.0.0.1:5173

# PostgreSQL local. No contiene credenciales institucionales.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=genares
DB_PASSWORD=genares_local
DB_NAME=genares
DB_SSL=false
DB_DISPOSABLE=false
