NODE_ENV=development
PORT=3001

# Identidad técnica fija para el desarrollo local; no representa un usuario.
LOCAL_DEV_OPEN_ACCESS=true
LOCAL_DEV_WRITE_ORIGINS=http://127.0.0.1:5173

# Base local exclusiva de desarrollo diario. Debe prepararse de forma autorizada;
# este archivo no crea la base ni ejecuta migraciones.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=genares
DB_PASSWORD=REEMPLAZAR_LOCALMENTE
DB_NAME=genares
DB_SSL=false
