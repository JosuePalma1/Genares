    asignaciones_tribunal {
        uuid id PK
        uuid id_trabajo FK
        estado_asignacion_tribunal_enum estado
        uuid assigned_by_id_cuenta FK
        timestamptz creado_en
        timestamptz confirmada_en
    }

    miembros_tribunal {
        uuid id PK
        uuid id_asignacion FK
        uuid id_docente FK
        smallint position
    }

    programaciones_sustentacion {
        uuid id PK
        uuid id_trabajo FK
        date fecha_programada
        time hora_programada
        varchar sala
        smallint duracion_estimada_minutos
        estado_sustentacion_enum estado
        timestamptz inicio_real_en
        timestamptz finalizacion_real_en
        uuid scheduled_by_id_cuenta FK
        varchar scheduled_by_actor_id
        timestamptz creado_en
        timestamptz actualizado_en
    }

    evaluaciones {
        uuid id PK
        uuid id_trabajo FK
        uuid id_miembro_tribunal FK
        uuid id_estudiante FK
        uuid id_version_rubrica FK
        uuid id_etapa_rubrica FK
        etapa_evaluacion_enum etapa
        estado_evaluacion_enum estado
        jsonb instantanea_rubrica
        numeric calificacion_total
        numeric instantanea_calificacion_maxima
        integer revision
        timestamptz cerrada_en
        timestamptz creado_en
        timestamptz actualizado_en
    }

    calificaciones_evaluacion {
        uuid id PK
        uuid id_evaluacion FK
        uuid id_indicador FK
        numeric score
        numeric instantanea_calificacion_maxima
        text observation
    }

    eventos_auditoria_evaluacion {
        uuid id PK
        uuid id_evaluacion FK
        varchar actor_id
        varchar accion
        jsonb detalles
        varchar correlation_id
        timestamptz ocurrido_en
    }

    traspasos_evaluacion_estudiante {
        uuid id PK
        uuid id_evaluacion FK
        uuid id_trabajo FK
        uuid id_estudiante FK
        timestamptz traspasado_en
    }

    notificaciones {
        uuid id PK
        uuid recipient_id_cuenta FK
        uuid id_trabajo FK
        tipo_notificacion_enum type
        varchar titulo
        text mensaje
        varchar ruta_accion
        timestamptz creado_en
        timestamptz leida_en
    }

    consecutivos_acta {
        uuid id_carrera PK, FK
        varchar periodo PK
        integer ultimo
    }

    actas_archivadas {
        uuid id PK
        varchar numero
        uuid id_carrera FK
        uuid id_periodo FK
        varchar periodo
        integer consecutivo
        uuid id_trabajo FK
        uuid id_estudiante FK
        varchar formato
        smallint revision
        timestamptz generado_en
        varchar generado_por
        bytea pdf
        varchar sha256
        numeric nota_final
        numeric nota_minima_aplicada
        boolean aprobado
    }

    configuracion_nota_minima {
        smallint id PK
        numeric valor
        timestamptz actualizado_en
        varchar actualizado_por
    }

    historial_nota_minima {
        bigint id PK
        numeric valor_anterior
        numeric valor_nuevo
        timestamptz cambiado_en
        varchar cambiado_por
    }

    eventos_trazabilidad_trabajo {
        uuid id PK
        uuid id_trabajo FK
        timestamptz ocurrido_en
        varchar tipo_evento
        varchar entidad_tipo
        uuid entidad_id
        varchar actor_id
        varchar actor_tipo
        varchar origen
        varchar correlation_id
        jsonb detalles
        varchar evidencia
        varchar fuente_tipo
        uuid fuente_id
    }

    personas ||--o| perfiles_estudiante : id_persona
    carreras ||--o{ perfiles_estudiante : id_carrera
    personas ||--o| perfiles_docente : id_persona
    carreras ||--o{ perfiles_docente : id_carrera
