%% GENARES — esquema acumulado de las migraciones 1760000000000 a 1760000015000.
%% Contraste: entidades TypeORM + migraciones SQL; se incluyen las tres tablas migration-only.
%% Cardinalidades expresan restricciones FK/UNIQUE; cada línea de relación corresponde a una FK.
%% Total derivado: 34 tablas y 63 restricciones FK.
%% Las marcas PK/FK de campos incluyen los componentes de claves compuestas.

erDiagram
    carreras {
        uuid id PK
        varchar codigo
        varchar nombre
        boolean esta_activo
        integer revision
        timestamptz creado_en
        timestamptz actualizado_en
    }

    modalidades {
        uuid id PK
        varchar codigo
        varchar nombre
        text descripcion
        boolean esta_activo
        integer revision
        timestamptz creado_en
        timestamptz actualizado_en
    }

    periodos_academicos {
        uuid id PK
        varchar codigo
        date fecha_inicio
        date fecha_fin
        boolean esta_activo
    }

    personas {
        uuid id PK
        varchar identificacion_nacional
        varchar nombres
        varchar surnames
        timestamptz creado_en
        timestamptz actualizado_en
    }

    perfiles_estudiante {
        uuid id PK
        uuid id_persona FK
        uuid id_carrera FK
    }

    perfiles_docente {
        uuid id PK
        uuid id_persona FK
        uuid id_carrera FK
        fuente_directorio_enum fuente
        varchar referencia_externa
        boolean esta_activo
    }

    cuentas_usuario {
        uuid id PK
        uuid id_persona FK
        varchar sujeto_autenticacion
        boolean esta_activo
        timestamptz creado_en
        timestamptz actualizado_en
    }

    roles {
        uuid id PK
        varchar codigo
        varchar nombre
    }

    roles_cuenta {
        uuid id PK
        uuid id_cuenta FK
        uuid id_rol FK
        timestamptz asignada_en
    }

    alcances_carrera_cuenta {
        uuid id PK
        uuid id_cuenta FK
        uuid id_carrera FK
    }

    rubricas {
        uuid id PK
        uuid id_modalidad FK
        varchar nombre
        text descripcion
        timestamptz creado_en
    }

    versiones_rubrica {
        uuid id PK
        uuid id_rubrica FK
        uuid periodo_academico_id FK
        uuid id_version_base FK
        varchar version
        estado_version_rubrica_enum estado
        integer revision
        timestamptz activada_en
        timestamptz creado_en
    }

    etapas_rubrica {
        uuid id PK
        uuid id_version_rubrica FK
        etapa_evaluacion_enum kind
        alcance_etapa_rubrica_enum scope
        varchar codigo
        varchar nombre
        text descripcion
        numeric calificacion_maxima
        numeric porcentaje
        smallint orden
    }

    categorias_rubrica {
        uuid id PK
        uuid id_version_rubrica FK
        uuid id_etapa_rubrica FK
        varchar codigo
        varchar nombre
        numeric calificacion_maxima
        smallint orden
    }

    indicadores_rubrica {
        uuid id PK
        uuid id_categoria FK
        varchar label
        text descripcion
        numeric calificacion_maxima
        smallint orden
    }

    auditoria_rubricas {
        uuid id PK
        varchar actor_id
        varchar accion
        uuid rubrica_id FK
        uuid modalidad_id FK
        uuid version_id FK
        uuid version_anterior_id FK
        uuid carrera_id FK
        uuid periodo_academico_id FK
        timestamptz ocurrido_en
        varchar correlation_id
    }

    versiones_rubrica_carreras {
        uuid id_version_rubrica PK, FK
        uuid id_carrera PK, FK
        uuid id_rubrica FK
        uuid id_modalidad FK
        uuid periodo_academico_id FK
        timestamptz asociado_en
    }

    vigencias_rubrica_carrera {
        uuid id PK
        uuid id_version_rubrica FK
        uuid id_carrera FK
        uuid id_rubrica FK
        uuid id_modalidad FK
        uuid periodo_academico_id FK
        timestamptz vigente_desde
        timestamptz vigente_hasta
    }

    trabajos_titulacion {
        uuid id PK
