        uuid id_version_rubrica FK
        estado_trabajo_enum estado
        uuid created_by_id_cuenta FK
        timestamptz creado_en
        timestamptz actualizado_en
    }

    estudiantes_trabajo {
        uuid id PK
        uuid id_trabajo FK
        uuid id_estudiante FK
        smallint orden_autoria
        timestamptz creado_en
    }

    asignaciones_tutor_trabajo {
        uuid id PK
