erDiagram
    %% Modelo conceptual de dominios. S1/S2/S3 son sistemas externos del encargo.
    %% Nombres, cardinalidades e identificadores externos son conceptuales y requieren contrato.
    %% No representan tablas, claves foraneas ni estructuras comprobadas de sistemas externos.
    %% La consolidacion calculable no es un resultado oficial persistido.
    %% Sistema 1: elegibilidad academica
    S1_CARRERA {
        string referencia_canonica PK "conceptual; contrato pendiente"
    }
    S1_PERIODO {
        string referencia_canonica PK "conceptual; contrato pendiente"
    }
    S1_TRABAJO_HABILITADO {
        string referencia_trabajo PK "conceptual"
        string estado_habilitacion "conceptual"
    }
    S1_INTEGRANTE {
        string referencia_persona PK "conceptual"
        string referencia_trabajo FK "conceptual"
    }
    S1_HABILITACION {
        string referencia PK "conceptual"
        string resultado "conceptual"
    }
    %% Sistema 2: documentos y requisitos
    S2_REQUISITO {
        string referencia PK "conceptual"
        string estado "conceptual"
    }
    S2_DOCUMENTO {
        string referencia PK "conceptual; no asumir almacenamiento"
        string tipo "conceptual"
    }
    S2_VERIFICACION {
        string referencia PK "conceptual"
        string resultado "conceptual"
    }
    %% Sistema 3: tribunal
    S3_ASIGNACION_TRIBUNAL {
        string referencia PK "conceptual"
        string estado_confirmacion "conceptual"
    }
    S3_MIEMBRO_TRIBUNAL {
        string referencia_persona PK "conceptual"
        string rol "conceptual; presidencia pendiente"
    }
    %% Genares: modelo operacional existente y extensiones conceptuales
    G_PERSONA {
        uuid id PK "tabla personas actual"
        string referencia_externa "mapeo pendiente"
    }
    G_CARRERA_REFERENCIA {
        uuid id PK "carreras actual"
        string codigo "local; fuente maestra pendiente"
    }
    G_PERIODO_REFERENCIA {
        uuid id PK "periodos_academicos actual"
        string codigo "local; fuente maestra pendiente"
    }
    G_TRABAJO {
        uuid id PK "trabajos_titulacion actual"
        string referencia_sistema_1 "campo/contrato por definir"
    }
    G_INTEGRANTE {
        uuid id PK "estudiantes_trabajo actual"
        uuid trabajo_id FK "actual"
        uuid estudiante_id FK "actual"
    }
    G_ASIGNACION_TRIBUNAL {
        uuid id PK "asignaciones_tribunal actual"
        uuid trabajo_id FK "actual"
        string referencia_sistema_3 "campo/contrato por definir"
    }
    G_MIEMBRO_TRIBUNAL {
        uuid id PK "miembros_tribunal actual"
        uuid asignacion_id FK "actual"
        uuid persona_id FK "relacion via perfil docente"
    }
    G_PROGRAMACION_LEGACY {
        uuid id PK "programaciones_sustentacion actual"
        uuid trabajo_id FK "una fila actual por trabajo"
        string horario "fecha, hora sin zona, sala textual"
    }
    G_FAMILIA_RUBRICA {
        uuid id PK "rubricas actual"
        string nombre "actual"
    }
    G_VERSION_RUBRICA {
        uuid id PK "versiones_rubrica actual"
        string revision "version completa inmutable"
    }
    G_ETAPA {
        uuid id PK "etapas_rubrica actual"
        string scope "compartida o individual explicita"
    }
    G_EVALUACION {
        uuid id PK "evaluaciones actuales"
        string estado "cerrada o en progreso"
    }
    G_TRASPASO {
        uuid id PK "traspasos_evaluacion_estudiante actual"
        uuid evaluacion_id FK "origen compartido"
        uuid estudiante_id FK "destino dentro del trabajo"
    }
    G_CRONOGRAMA_PROPUESTO {
        string id PK "propuesta, no implementada"
        string estado "propuesta"
    }
    G_VERSION_CRONOGRAMA_PROPUESTA {
        string id PK "version propuesta"
        string estado "borrador/propuesta/aprobada/publicada candidate"
    }
    G_SESION_CRONOGRAMA_PROPUESTA {
        string id PK "sesion propuesta"
        string intervalo "timestamptz y zona IANA propuestas"
    }
    G_APROBACION_EXTERNA_PROPUESTA {
        string id PK "referencia de evidencia, propuesta"
        string acta_ref "estructura pendiente"
    }
    G_RESULTADO_CALCULABLE {
        string referencia PK "vista bajo demanda; no tabla actual"
        string estado_completitud "conceptual"
    }
    G_RESULTADO_OFICIAL_PENDIENTE {
        string referencia PK "evento/estructura pendiente"
        string acta_ref "referencia pendiente"
    }
    S1_CARRERA o|..o{ S1_TRABAJO_HABILITADO : "conceptual; cardinalidad a confirmar"
    S1_PERIODO o|..o{ S1_TRABAJO_HABILITADO : "conceptual; cardinalidad a confirmar"
    S1_TRABAJO_HABILITADO ||..o{ S1_INTEGRANTE : "conceptual"
    S1_TRABAJO_HABILITADO ||..o| S1_HABILITACION : "conceptual; flujo por definir"
    S2_REQUISITO ||..o{ S2_VERIFICACION : "conceptual"
    S2_DOCUMENTO o|..o{ S2_VERIFICACION : "conceptual"
    S1_TRABAJO_HABILITADO ||..o{ S2_VERIFICACION : "referencia de trabajo; contrato pendiente"
    S3_ASIGNACION_TRIBUNAL ||..o{ S3_MIEMBRO_TRIBUNAL : "conceptual"
    S1_TRABAJO_HABILITADO o|..o| G_TRABAJO : "mapeo de identificador pendiente"
    S1_INTEGRANTE o|..o{ G_INTEGRANTE : "mapeo de identidad pendiente"
    S1_CARRERA o|..o| G_CARRERA_REFERENCIA : "catalogo canonico pendiente"
    S1_PERIODO o|..o| G_PERIODO_REFERENCIA : "catalogo canonico pendiente"
    S3_ASIGNACION_TRIBUNAL o|..o| G_ASIGNACION_TRIBUNAL : "fuente de verdad pendiente"
    S3_MIEMBRO_TRIBUNAL o|..o{ G_MIEMBRO_TRIBUNAL : "identidad/rol por mapear"
    G_TRABAJO ||..o{ G_INTEGRANTE : "relacion local actual"
    G_ASIGNACION_TRIBUNAL ||..o{ G_MIEMBRO_TRIBUNAL : "relacion local actual"
    G_TRABAJO ||..o| G_PROGRAMACION_LEGACY : "programacion actual"
    G_FAMILIA_RUBRICA ||..o{ G_VERSION_RUBRICA : "familia y revisiones"
    G_VERSION_RUBRICA ||..o{ G_ETAPA : "version contiene etapas"
    G_TRABAJO o|..o| G_VERSION_RUBRICA : "version fijada al trabajo"
    G_TRABAJO ||..o{ G_EVALUACION : "evaluaciones actuales"
    G_ETAPA ||..o{ G_EVALUACION : "etapa dinamica"
    G_EVALUACION ||..o{ G_TRASPASO : "origen compartido"
    G_INTEGRANTE ||..o{ G_TRASPASO : "destino estudiante"
    G_CRONOGRAMA_PROPUESTO ||..o{ G_VERSION_CRONOGRAMA_PROPUESTA : "versiones propuestas"
    G_VERSION_CRONOGRAMA_PROPUESTA ||..o| G_APROBACION_EXTERNA_PROPUESTA : "evidencia para version"
    G_VERSION_CRONOGRAMA_PROPUESTA ||..o{ G_SESION_CRONOGRAMA_PROPUESTA : "sesiones de version"
    G_TRABAJO ||..o{ G_SESION_CRONOGRAMA_PROPUESTA : "trabajos en sesiones"
    G_TRABAJO ||..o{ G_RESULTADO_CALCULABLE : "resultado calculable por estudiante"
    G_INTEGRANTE ||..o{ G_RESULTADO_CALCULABLE : "resultado individual"
    G_RESULTADO_CALCULABLE }o..o{ G_EVALUACION : "agrega cierres y traspasos"
    G_RESULTADO_CALCULABLE o|..o| G_RESULTADO_OFICIAL_PENDIENTE : "solo tras acto institucional"
    S2_DOCUMENTO o|..o| G_RESULTADO_OFICIAL_PENDIENTE : "referencia documental; contrato pendiente"
