erDiagram
    %% PROP_ identifica propuesta futura; entidades actuales referenciadas son fisicas.
    %% Subconjunto; consultar el DER principal para notas y contexto.
    ASIGNACIONES_TRIBUNAL {
        uuid id PK "uuid NOT NULL PK"
        uuid id_trabajo FK "uuid NOT NULL"
        estado_asignacion_tribunal_enum estado "estado_asignacion_tribunal_enum NOT NULL"
        uuid assigned_by_id_cuenta FK "uuid NOT NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        timestamptz confirmada_en "timestamptz NULL"
    }
    CARRERAS {
        uuid id PK "uuid NOT NULL PK"
        varchar codigo "varchar(30) NOT NULL"
        varchar nombre "varchar(160) NOT NULL"
        boolean esta_activo "boolean NOT NULL"
        integer revision "integer NOT NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        timestamptz actualizado_en "timestamptz NOT NULL"
    }
    MIEMBROS_TRIBUNAL {
        uuid id PK "uuid NOT NULL PK"
        uuid id_asignacion FK "uuid NOT NULL"
        uuid id_docente FK "uuid NOT NULL"
        smallint position "smallint NOT NULL"
    }
    PERIODOS_ACADEMICOS {
        uuid id PK "uuid NOT NULL PK"
        varchar codigo "varchar(20) NOT NULL"
        date fecha_inicio "date NULL"
        date fecha_fin "date NULL"
        boolean esta_activo "boolean NOT NULL"
    }
    PERSONAS {
        uuid id PK "uuid NOT NULL PK"
        varchar identificacion_nacional "varchar(20) NOT NULL"
        varchar nombres "varchar(160) NOT NULL"
        varchar surnames "varchar(160) NOT NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        timestamptz actualizado_en "timestamptz NOT NULL"
    }
    TRABAJOS_TITULACION {
        uuid id PK "uuid NOT NULL PK"
        varchar codigo "varchar(40) NOT NULL"
        text titulo "text NOT NULL"
        uuid id_modalidad FK "uuid NOT NULL"
        uuid periodo_academico_id FK "uuid NOT NULL"
        uuid id_carrera FK "uuid NOT NULL"
        uuid id_version_rubrica FK "uuid NULL"
        estado_trabajo_enum estado "estado_trabajo_enum NOT NULL"
        uuid created_by_id_cuenta FK "uuid NOT NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        timestamptz actualizado_en "timestamptz NOT NULL"
    }
    PROP_CRONOGRAMAS_SUSTENTACION {
        uuid id PK "propuesta"
        uuid periodo_academico_id FK "propuesta"
        varchar nombre "propuesta"
        varchar estado "propuesta"
    }
    PROP_CRONOGRAMA_CARRERAS {
        uuid id_cronograma PK, FK "propuesta"
        uuid id_carrera PK, FK "propuesta"
    }
    PROP_VERSIONES_CRONOGRAMA {
        uuid id PK "propuesta"
        uuid id_cronograma FK "propuesta"
        uuid id_version_anterior FK "propuesta nullable; reemplazo"
        integer numero_version "propuesta"
        varchar estado "propuesta"
        timestamptz creada_en "propuesta"
    }
    PROP_SALAS_SUSTENTACION {
        uuid id PK "propuesta"
        varchar codigo "propuesta"
        varchar nombre "propuesta"
        boolean activa "propuesta"
    }
    PROP_SESIONES_SUSTENTACION {
        uuid id PK "propuesta"
        uuid id_version_cronograma FK "propuesta"
        uuid id_trabajo FK "propuesta"
        uuid id_asignacion_tribunal FK "propuesta"
        timestamptz inicio "propuesta"
        timestamptz fin "propuesta"
        varchar zona_horaria "propuesta IANA"
        varchar estado "propuesta"
    }
    PROP_APROBACIONES_EXTERNAS_CRONOGRAMA {
        uuid id_version_cronograma PK, FK "propuesta"
        varchar referencia_evidencia "propuesta"
        varchar referencia_acta "propuesta"
        timestamptz aprobada_en "propuesta"
        uuid registrada_por_cuenta FK "propuesta nullable"
    }
    PROP_EVENTOS_CRONOGRAMA {
        uuid id PK "propuesta"
        uuid id_version_cronograma FK "propuesta"
        uuid id_sesion FK "propuesta nullable"
        varchar tipo_evento "propuesta"
        varchar actor_referencia "propuesta"
        timestamptz ocurrido_en "propuesta"
    }
    PROP_PARTICIPANTES_SESION {
        uuid id PK "propuesta"
        uuid id_sesion FK "propuesta"
        uuid id_persona FK "propuesta"
        uuid id_miembro_tribunal FK "propuesta nullable"
        varchar rol "propuesta"
        boolean bloquea_solapamiento "pendiente institucional"
    }
    PROP_RESERVAS_RECURSO_SESION {
        uuid id PK "propuesta"
        uuid id_sesion FK "propuesta"
        uuid id_sala FK "propuesta nullable"
        uuid id_persona FK "propuesta nullable"
        tstzrange periodo "propuesta [inicio, fin)"
        varchar estado "propuesta"
    }
    TRABAJOS_TITULACION ||--o{ ASIGNACIONES_TRIBUNAL : id_trabajo
    ASIGNACIONES_TRIBUNAL ||--o{ MIEMBROS_TRIBUNAL : id_asignacion
    CARRERAS ||--o{ TRABAJOS_TITULACION : id_carrera
    PERIODOS_ACADEMICOS ||--o{ TRABAJOS_TITULACION : periodo_academico_id
    TRABAJOS_TITULACION ||--o{ PROP_SESIONES_SUSTENTACION : propuesta_trabajo
    ASIGNACIONES_TRIBUNAL ||--o{ PROP_SESIONES_SUSTENTACION : propuesta_tribunal_confirmado
    PERIODOS_ACADEMICOS ||--o{ PROP_CRONOGRAMAS_SUSTENTACION : propuesta_periodo
    PROP_CRONOGRAMAS_SUSTENTACION ||--o{ PROP_CRONOGRAMA_CARRERAS : propuesta
    CARRERAS ||--o{ PROP_CRONOGRAMA_CARRERAS : propuesta
    PROP_CRONOGRAMAS_SUSTENTACION ||--o{ PROP_VERSIONES_CRONOGRAMA : propuesta
    PROP_VERSIONES_CRONOGRAMA o|--o{ PROP_VERSIONES_CRONOGRAMA : version_anterior_propuesta
    PROP_VERSIONES_CRONOGRAMA ||--o{ PROP_SESIONES_SUSTENTACION : propuesta
    PROP_VERSIONES_CRONOGRAMA ||--o| PROP_APROBACIONES_EXTERNAS_CRONOGRAMA : evidencia_externa_propuesta
    PROP_VERSIONES_CRONOGRAMA ||--o{ PROP_EVENTOS_CRONOGRAMA : historial_append_only_propuesto
    PROP_SESIONES_SUSTENTACION o|--o{ PROP_EVENTOS_CRONOGRAMA : eventos_de_sesion_propuestos
    PROP_SESIONES_SUSTENTACION ||--o{ PROP_PARTICIPANTES_SESION : propuesta
    PERSONAS ||--o{ PROP_PARTICIPANTES_SESION : identidad_existente
    MIEMBROS_TRIBUNAL o|--o{ PROP_PARTICIPANTES_SESION : lector_existente
    PROP_SESIONES_SUSTENTACION ||--o{ PROP_RESERVAS_RECURSO_SESION : propuesta
    PROP_SALAS_SUSTENTACION o|--o{ PROP_RESERVAS_RECURSO_SESION : recurso_sala
    PERSONAS o|--o{ PROP_RESERVAS_RECURSO_SESION : recurso_persona
