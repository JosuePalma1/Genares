erDiagram
    %% Modelo fisico actual: versiones, etapas, puntajes y trazabilidad.
    %% Subconjunto; consultar el DER principal para notas y contexto.
    ASIGNACIONES_TRIBUNAL {
        uuid id PK "uuid NOT NULL PK"
        uuid id_trabajo FK "uuid NOT NULL"
        estado_asignacion_tribunal_enum estado "estado_asignacion_tribunal_enum NOT NULL"
        uuid assigned_by_id_cuenta FK "uuid NOT NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        timestamptz confirmada_en "timestamptz NULL"
    }
    AUDITORIA_RUBRICAS {
        uuid id PK "uuid NOT NULL PK"
        varchar actor_id "varchar(255) NOT NULL"
        varchar accion "varchar(64) NOT NULL"
        uuid rubrica_id FK "uuid NOT NULL"
        uuid version_id FK "uuid NULL"
        timestamptz ocurrido_en "timestamptz NOT NULL"
        varchar correlation_id "varchar(100) NULL"
        uuid modalidad_id FK "uuid NULL"
        uuid carrera_id FK "uuid NULL"
        uuid periodo_academico_id FK "uuid NULL"
        uuid version_anterior_id FK "uuid NULL"
    }
    CALIFICACIONES_EVALUACION {
        uuid id PK "uuid NOT NULL PK"
        uuid id_evaluacion FK "uuid NOT NULL"
        uuid id_indicador FK "uuid NOT NULL"
        numeric score "numeric(4,2) NOT NULL"
        numeric instantanea_calificacion_maxima "numeric(4,2) NOT NULL"
        text observation "text NULL"
    }
    CARRERAS {
        uuid id PK "uuid NOT NULL PK"
        varchar codigo "varchar(30) NOT NULL"
        varchar nombre "varchar(160) NOT NULL"
        boolean esta_activo "boolean NOT NULL"
        integer revision "integer NOT NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        timestamptz actualizado_en "timestamptz NOT NULL"
    }
    CATEGORIAS_RUBRICA {
        uuid id PK "uuid NOT NULL PK"
        uuid id_version_rubrica FK "uuid NOT NULL"
        etapa_evaluacion_enum etapa "etapa_evaluacion_enum NULL"
        varchar codigo "varchar(10) NOT NULL"
        varchar nombre "varchar(240) NOT NULL"
        numeric calificacion_maxima "numeric(4,2) NOT NULL"
        smallint orden "smallint NOT NULL"
        uuid id_etapa_rubrica FK "uuid NULL"
    }
    ETAPAS_RUBRICA {
        uuid id PK "uuid NOT NULL PK"
        uuid id_version_rubrica FK "uuid NOT NULL"
        etapa_evaluacion_enum kind "etapa_evaluacion_enum NOT NULL"
        alcance_etapa_rubrica_enum scope "alcance_etapa_rubrica_enum NOT NULL"
        varchar codigo "varchar(40) NOT NULL"
        varchar nombre "varchar(220) NOT NULL"
        text descripcion "text NULL"
        numeric calificacion_maxima "numeric(5,2) NOT NULL"
        numeric porcentaje "numeric(5,2) NULL"
        smallint orden "smallint NOT NULL"
    }
    EVALUACIONES {
        uuid id PK "uuid NOT NULL PK"
        uuid id_trabajo FK "uuid NOT NULL"
        uuid id_miembro_tribunal FK "uuid NOT NULL"
        uuid id_estudiante FK "uuid NULL"
        uuid id_version_rubrica FK "uuid NOT NULL"
        etapa_evaluacion_enum etapa "etapa_evaluacion_enum NOT NULL"
        estado_evaluacion_enum estado "estado_evaluacion_enum NOT NULL"
        jsonb instantanea_rubrica "jsonb NOT NULL"
        numeric calificacion_total "numeric(4,2) NOT NULL"
        numeric instantanea_calificacion_maxima "numeric(4,2) NOT NULL"
        timestamptz cerrada_en "timestamptz NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        timestamptz actualizado_en "timestamptz NOT NULL"
        uuid id_etapa_rubrica FK "uuid NULL"
        integer revision "integer NOT NULL"
    }
    EVENTOS_AUDITORIA_EVALUACION {
        uuid id PK "uuid NOT NULL PK"
        uuid id_evaluacion FK "uuid NOT NULL"
        varchar actor_id "varchar(255) NOT NULL"
        varchar accion "varchar(64) NOT NULL"
        jsonb detalles "jsonb NOT NULL"
        varchar correlation_id "varchar(100) NULL"
        timestamptz ocurrido_en "timestamptz NOT NULL"
    }
    INDICADORES_RUBRICA {
        uuid id PK "uuid NOT NULL PK"
        uuid id_categoria FK "uuid NOT NULL"
        varchar label "varchar(40) NOT NULL"
        text descripcion "text NOT NULL"
        numeric calificacion_maxima "numeric(4,2) NOT NULL"
        smallint orden "smallint NOT NULL"
    }
    MIEMBROS_TRIBUNAL {
        uuid id PK "uuid NOT NULL PK"
        uuid id_asignacion FK "uuid NOT NULL"
        uuid id_docente FK "uuid NOT NULL"
        smallint position "smallint NOT NULL"
    }
    MODALIDADES {
        uuid id PK "uuid NOT NULL PK"
        varchar codigo "varchar(40) NOT NULL"
        varchar nombre "varchar(160) NOT NULL"
        boolean esta_activo "boolean NOT NULL"
        text descripcion "text NULL"
        integer revision "integer NOT NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        timestamptz actualizado_en "timestamptz NOT NULL"
    }
    PERFILES_ESTUDIANTE {
        uuid id PK "uuid NOT NULL PK"
        uuid id_persona FK "uuid NOT NULL"
        uuid id_carrera FK "uuid NOT NULL"
    }
    PERIODOS_ACADEMICOS {
        uuid id PK "uuid NOT NULL PK"
        varchar codigo "varchar(20) NOT NULL"
        date fecha_inicio "date NULL"
        date fecha_fin "date NULL"
        boolean esta_activo "boolean NOT NULL"
    }
    RUBRICAS {
        uuid id PK "uuid NOT NULL PK"
        uuid id_modalidad FK "uuid NOT NULL"
        varchar nombre "varchar(220) NOT NULL"
        text descripcion "text NULL"
        timestamptz creado_en "timestamptz NOT NULL"
    }
    TRABAJOS_TITULACION {
        uuid id PK "uuid NOT NULL PK"
        varchar codigo "varchar(40) NOT NULL"
        text titulo "text NOT NULL"
        uuid id_modalidad FK "uuid NOT NULL"
        uuid periodo_academico_id FK "uuid NOT NULL"
        uuid id_carrera FK "uuid NOT NULL"
        uuid id_version_rubrica FK "uuid NULL"
        estado_trabajo_enum estado "estado_trabajo_enum NOT NULL"
        uuid created_by_id_cuenta FK "uuid NOT NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        timestamptz actualizado_en "timestamptz NOT NULL"
    }
    TRASPASOS_EVALUACION_ESTUDIANTE {
        uuid id PK "uuid NOT NULL PK"
        uuid id_evaluacion FK "uuid NOT NULL"
        uuid id_trabajo FK "uuid NOT NULL"
        uuid id_estudiante FK "uuid NOT NULL"
        timestamptz traspasado_en "timestamptz NOT NULL"
    }
    VERSIONES_RUBRICA {
        uuid id PK "uuid NOT NULL PK"
        uuid id_rubrica FK "uuid NOT NULL"
        uuid periodo_academico_id FK "uuid NOT NULL"
        varchar version "varchar(30) NOT NULL"
        estado_version_rubrica_enum estado "estado_version_rubrica_enum NOT NULL"
        numeric written_calificacion_maxima "numeric(4,2) NULL"
        numeric oral_calificacion_maxima "numeric(4,2) NULL"
        timestamptz activada_en "timestamptz NULL"
        timestamptz creado_en "timestamptz NOT NULL"
        integer revision "integer NOT NULL"
        uuid id_version_base FK "uuid NULL"
    }
    VERSIONES_RUBRICA_CARRERAS {
        uuid id_version_rubrica PK, FK "uuid NOT NULL PK, FK"
        uuid id_carrera PK, FK "uuid NOT NULL PK, FK"
        uuid id_rubrica FK "uuid NOT NULL"
        uuid id_modalidad FK "uuid NOT NULL"
        uuid periodo_academico_id FK "uuid NOT NULL"
        timestamptz asociado_en "timestamptz NOT NULL"
    }
    VIGENCIAS_RUBRICA_CARRERA {
        uuid id PK "uuid NOT NULL PK"
        uuid id_version_rubrica FK "uuid NOT NULL"
        uuid id_carrera FK "uuid NOT NULL"
        uuid id_rubrica FK "uuid NOT NULL"
        uuid id_modalidad FK "uuid NOT NULL"
        uuid periodo_academico_id FK "uuid NOT NULL"
        timestamptz vigente_desde "timestamptz NOT NULL"
        timestamptz vigente_hasta "timestamptz NULL"
    }
    TRABAJOS_TITULACION ||--o{ ASIGNACIONES_TRIBUNAL : id_trabajo
    CARRERAS o|--o{ AUDITORIA_RUBRICAS : carrera_id
    MODALIDADES o|--o{ AUDITORIA_RUBRICAS : modalidad_id
    PERIODOS_ACADEMICOS o|--o{ AUDITORIA_RUBRICAS : periodo_academico_id
    RUBRICAS ||--o{ AUDITORIA_RUBRICAS : rubrica_id
    VERSIONES_RUBRICA o|--o{ AUDITORIA_RUBRICAS : version_id
    VERSIONES_RUBRICA o|--o{ AUDITORIA_RUBRICAS : version_rubrica_compuesta
    VERSIONES_RUBRICA o|--o{ AUDITORIA_RUBRICAS : version_anterior_familia_compuesta
    EVALUACIONES ||--o{ CALIFICACIONES_EVALUACION : id_evaluacion
    INDICADORES_RUBRICA ||--o{ CALIFICACIONES_EVALUACION : id_indicador
    ETAPAS_RUBRICA o|--o{ CATEGORIAS_RUBRICA : id_etapa_rubrica
    VERSIONES_RUBRICA ||--o{ CATEGORIAS_RUBRICA : id_version_rubrica
    VERSIONES_RUBRICA ||--o{ ETAPAS_RUBRICA : id_version_rubrica
    PERFILES_ESTUDIANTE o|--o{ EVALUACIONES : id_estudiante
    ETAPAS_RUBRICA o|--o{ EVALUACIONES : etapa_version_compuesta
    MIEMBROS_TRIBUNAL ||--o{ EVALUACIONES : id_miembro_tribunal
    TRABAJOS_TITULACION ||--o{ EVALUACIONES : id_trabajo
    VERSIONES_RUBRICA ||--o{ EVALUACIONES : id_version_rubrica
    EVALUACIONES ||--o{ EVENTOS_AUDITORIA_EVALUACION : id_evaluacion
    CATEGORIAS_RUBRICA ||--o{ INDICADORES_RUBRICA : id_categoria
    ASIGNACIONES_TRIBUNAL ||--o{ MIEMBROS_TRIBUNAL : id_asignacion
    CARRERAS ||--o{ PERFILES_ESTUDIANTE : id_carrera
    MODALIDADES ||--o| RUBRICAS : id_modalidad
    CARRERAS ||--o{ TRABAJOS_TITULACION : id_carrera
    MODALIDADES ||--o{ TRABAJOS_TITULACION : id_modalidad
    VERSIONES_RUBRICA o|--o{ TRABAJOS_TITULACION : id_version_rubrica
    PERIODOS_ACADEMICOS ||--o{ TRABAJOS_TITULACION : periodo_academico_id
    PERFILES_ESTUDIANTE ||--o{ TRASPASOS_EVALUACION_ESTUDIANTE : id_estudiante
    EVALUACIONES ||--o{ TRASPASOS_EVALUACION_ESTUDIANTE : evaluacion_trabajo_compuesta
    RUBRICAS ||--o{ VERSIONES_RUBRICA : id_rubrica
    VERSIONES_RUBRICA o|--o{ VERSIONES_RUBRICA : base_misma_familia
    PERIODOS_ACADEMICOS ||--o{ VERSIONES_RUBRICA : periodo_academico_id
    CARRERAS ||--o{ VERSIONES_RUBRICA_CARRERAS : id_carrera
    RUBRICAS ||--o{ VERSIONES_RUBRICA_CARRERAS : rubrica_modalidad_compuesta
    VERSIONES_RUBRICA ||--o{ VERSIONES_RUBRICA_CARRERAS : version_contexto_compuesto
    VERSIONES_RUBRICA_CARRERAS ||--o{ VIGENCIAS_RUBRICA_CARRERA : asociacion_contexto_compuesta
