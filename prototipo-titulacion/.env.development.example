# La aplicación conserva el prototipo por defecto. Cambiar a "api" habilita solo lectura en Vite dev.
VITE_RUBRICAS_SOURCE=prototipo
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
# Habilita únicamente el cliente de servicios; no crea botones ni una identidad.
VITE_RUBRICAS_WRITE_API=false
VITE_MODALIDADES_WRITE_API=false
